# ===================================================================
# ATTT Portal - Example Environment Template (.env.example)
# ===================================================================

# 1. Cấu hình DeepSeek AI (Lấy key tại: https://platform.deepseek.com/api_keys)
DEEPSEEK_API_KEY=sk-your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat
LLM_API_URL=https://api.deepseek.com/chat/completions

# 2. Hoặc Groq AI (Lấy key tại: https://console.groq.com/keys)
# GROQ_API_KEY=gsk_your_groq_api_key_here
# GROQ_MODEL=qwen/qwen3.8-27b
# LLM_API_URL=https://api.groq.com/openai/v1/chat/completions

# 3. Cấu hình Database PostgreSQL (Khớp với docker-compose.yaml)
DB_HOST=localhost
DB_PORT=54321
DB_NAME=attt
DB_USER=postgres
DB_PASSWORD=123456
